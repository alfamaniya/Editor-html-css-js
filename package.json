{
  "name": "editor-html-css-js",
  "version": "1.0.0",
  "private": true,
  "description": "HTML, CSS and JavaScript editor with build and quality-check scripts.",
  "scripts": {
    "check:index": "node scripts/check-index-integrity.mjs",
    "check:main": "node scripts/check-standalone-editor.mjs",
    "check:visual": "node scripts/check-standalone-visual-editor.mjs",
    "check:combined": "node scripts/check-combined-editor.mjs",
    "build:main": "node scripts/build-test-editor.mjs",
    "build:visual": "node scripts/build-standalone-visual-editor.mjs",
    "build:combined": "node scripts/build-combined-editor.mjs",
    "build:all": "npm run build:codemirror && npm run build:main && npm run check:main && npm run build:visual && npm run check:visual && npm run build:combined && npm run check:combined",
    "test": "npm run check:index",
    "build:codemirror": "node scripts/build-codemirror.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
